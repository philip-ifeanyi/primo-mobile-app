# Base URL of the Primo API (ABP backend).
#
# This is the value the web portal (primo-portal-nextjs) hardcodes. It is a
# raw IP on a non-standard port, so expect a certificate that iOS will not
# trust by default — if requests fail with "No connection", check that first.
#
# Leave unset to run the app on local stubs.
EXPO_PUBLIC_API_URL=https://104.131.48.195:44301/api

# ABP tenant. The portal authenticates with tenantId 1.
EXPO_PUBLIC_TENANT_ID=1

# Note: EXPO_PUBLIC_* values are inlined into the app bundle at build time.
# They are visible to anyone with the binary — never put a secret here.
# Metro must be restarted (npx expo start --clear) after changing this file.
